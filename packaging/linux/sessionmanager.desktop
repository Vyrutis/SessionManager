[Desktop Entry]
Type=Application
Name=Session Manager
GenericName=SSH and Remote Desktop Manager
GenericName[lt]=SSH ir nuotolinio darbalaukio tvarkytuvė
Comment=SSH, Remote Desktop (RDP) and VNC connections in tabs, with SFTP and connection import
Comment[lt]=SSH, nuotolinio darbalaukio (RDP) ir VNC ryšiai kortelėse, su SFTP ir ryšių importu
Exec=sessionmanager %F
Icon=sessionmanager
Terminal=false
Categories=Network;RemoteAccess;System;
Keywords=ssh;rdp;vnc;remote;desktop;sftp;terminal;putty;remmina;freerdp;ultravnc;
MimeType=application/x-sessionmanager-list;application/x-sessionmanager-session;
StartupWMClass=sessionmanager
StartupNotify=true
