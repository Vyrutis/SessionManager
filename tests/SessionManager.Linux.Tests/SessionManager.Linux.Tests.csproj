<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test runner for the Linux app (runs on Linux and Windows): dotnet run, from this folder.
       Pass a folder as the first argument to also save screenshots of the windows there. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SessionManager.Linux\SessionManager.Linux.csproj" />
  </ItemGroup>
</Project>
