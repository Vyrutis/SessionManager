<Window x:Class="SessionManager.SessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SessionManager"
        Title="Session" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <GroupBox Header="Connection" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource Label}" Text="Name:" />
                <TextBox x:Name="NameBox" Grid.Column="1" />

                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Host:" />
                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HostBox" ToolTip="Host name or IP address" />
                    <TextBlock Grid.Column="1" Text="Port:" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <TextBox x:Name="PortBox" Grid.Column="2" />
                </Grid>

                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Credentials:" />
                <ComboBox x:Name="CredentialBox" Grid.Row="2" Grid.Column="1" SelectionChanged="CredentialBox_SelectionChanged"
                          ToolTip="Use a shared credential profile, or enter a username and password for this session only" />

                <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="Username:" />
                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7*" />
                    </Grid.ColumnDefinitions>
                    <local:DomainPicker x:Name="DomainBox" Margin="0,3" />
                    <TextBlock Grid.Column="1" Text="\" FontSize="14" Margin="6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SubTextBrush}" />
                    <TextBox x:Name="UserBox" Grid.Column="2" />
                </Grid>

                <TextBlock Style="{StaticResource Label}" Grid.Row="4" Text="Password:" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" />
                <TextBlock x:Name="PasswordHint" Grid.Row="4" Grid.Column="1" IsHitTestVisible="False"
                           Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                           Text="(saved — leave empty to keep it)" />

                <CheckBox x:Name="SavePasswordBox" Grid.Row="5" Grid.Column="1" Content="Save password in Windows Credential Manager" />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="SshGroup" Header="SSH" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Private key:" />
                <TextBox x:Name="KeyBox" Grid.Column="1" ToolTip="Optional. Keys in your .ssh folder are also tried automatically." />
                <Button Grid.Column="2" Content="Browse…" Margin="6,3,0,3" Padding="8,0" Click="BrowseKey_Click" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                           Text="If the key is protected by a passphrase, the saved password is used as the passphrase." />

                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="Jump host:" />
                <ComboBox x:Name="JumpBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          ToolTip="Connect through another saved SSH session (bastion / gateway)" />

                <TextBlock Style="{StaticResource Label}" Grid.Row="3" Text="Font:" />
                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <ComboBox x:Name="FontBox" Width="180" />
                    <ComboBox x:Name="FontSizeBox" Width="70" Margin="8,3,0,3" />
                </StackPanel>

                <TextBlock Style="{StaticResource Label}" Grid.Row="4" Text="Colors:" />
                <ComboBox x:Name="SchemeBox" Grid.Row="4" Grid.Column="1" Width="180" HorizontalAlignment="Left"
                          ToolTip="Auto follows the app's Silver / Midnight theme" />

                <TextBlock Style="{StaticResource Label}" Grid.Row="5" Text="Tunnels:" VerticalAlignment="Top" Margin="0,6,12,0" />
                <TextBox x:Name="TunnelsBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" AcceptsReturn="True" Height="58"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Hint}"
                           Text="One per line:  L 8080:db.internal:5432  (local port → host reached from the server)&#x0a;R 9000:localhost:3000  (server port → this PC)    D 1080  (SOCKS proxy)" />
            </Grid>
        </GroupBox>

        <GroupBox x:Name="RdpGroup" Header="Remote Desktop" Padding="8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Label}" Text="Resolution:" />
                <ComboBox x:Name="ResolutionBox" Grid.Column="1" />
                <TextBlock Style="{StaticResource Label}" Grid.Row="1" Text="Colors:" />
                <ComboBox x:Name="ColorBox" Grid.Row="1" Grid.Column="1" />
                <TextBlock Style="{StaticResource Label}" Grid.Row="2" Text="SSH gateway:" />
                <ComboBox x:Name="RdpJumpBox" Grid.Row="2" Grid.Column="1"
                          ToolTip="Tunnel the Remote Desktop connection through a saved SSH session" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,0">
                    <CheckBox x:Name="ClipboardBox" Content="Share clipboard" />
                    <CheckBox x:Name="DrivesBox" Content="Share local drives" />
                    <CheckBox x:Name="PrintersBox" Content="Share printers" />
                    <CheckBox x:Name="SmartSizingBox" Content="Stretch the picture instead of resizing the remote desktop"
                              ToolTip="With Fit to tab, the remote desktop is resized to match the tab (sharp). Tick this to stretch the picture instead (can look blurry). Fixed resolutions are always stretched to fit." />
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="80" Padding="10,3" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Padding="10,3" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
