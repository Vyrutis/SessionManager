<Window x:Class="SessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SessionManager"
        xmlns:core="clr-namespace:SessionManager;assembly=SessionManager.Core"
        Title="Session Manager" Icon="pack://application:,,,/SessionManager;component/Assets/app.ico" Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <!-- Custom title bar: the app draws its own caption so the theme switch can sit next to minimize. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Toolbar labels are hidden (icons only) when the window is too narrow for them. -->
        <Visibility x:Key="ToolLabelVisibility">Visible</Visibility>
        <Thickness x:Key="ToolIconMargin">0,0,6,0</Thickness>

        <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Width" Value="20" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- Minimize / maximize / close -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource Icons}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tree expander: chevron that rotates when expanded -->
        <!-- SSH / RDP / VNC tab above the session list: underlined in the accent color when active -->
        <Style x:Key="ListTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Bd" CornerRadius="6,6,0,0" Padding="4,6,4,7" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Line" Height="2" VerticalAlignment="Bottom" Margin="6,0" CornerRadius="1"
                                    Background="{DynamicResource AccentBrush}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeExpander" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="18" Height="18" VerticalAlignment="Center">
                            <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="9"
                                       Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Palette button in the title bar: opens the appearance menu -->
        <Style x:Key="PaletteButton" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Width="30" Height="28" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource Icons}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Small dot in the current accent color -->
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                         Margin="0,0,5,5" Stroke="{DynamicResource TitleBarBrush}" StrokeThickness="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light/dark switch: sun on the left, moon on the right -->
        <Style x:Key="ThemeSwitch" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent" Margin="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE706;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="0,0,7,0" />
                                <Border x:Name="Track" Width="38" Height="20" CornerRadius="10" Background="{DynamicResource ToggleTrackBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="{DynamicResource ToggleThumbBrush}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbShift" X="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                                <TextBlock Text="&#xE708;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SubTextBrush}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
        <!-- Custom background picture (palette menu); the surfaces above it are partly see-through when it is set. -->
        <Image x:Name="BackgroundLayer" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
        <Grid x:Name="RootGrid" LayoutTransform="{DynamicResource UiScale}">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="{DynamicResource ShellTitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="16" Height="16" VerticalAlignment="Center" Margin="12,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Grid.Column="1" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ToggleButton x:Name="PaletteButton" Grid.Column="2" Style="{StaticResource PaletteButton}" Margin="0,0,2,0"
                              ToolTip="Appearance: colors, background picture, size"
                              IsChecked="{Binding IsOpen, ElementName=ThemePopup, Mode=TwoWay}" />
                <Popup x:Name="ThemePopup" Grid.Column="2" PlacementTarget="{Binding ElementName=PaletteButton}" Placement="Custom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="ThemePopup_Opened" Closed="ThemePopup_Closed" />
                <ToggleButton x:Name="ThemeToggle" Grid.Column="3" Style="{StaticResource ThemeSwitch}"
                              ToolTip="Switch between Silver (light) and Midnight (dark)"
                              Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed" />
                <Button Grid.Column="4" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Grid.Column="5" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                <Button Grid.Column="6" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
            </Grid>

            <!-- Toolbar -->
            <Border x:Name="ToolbarBorder" Grid.Row="1" Background="{DynamicResource ShellToolbarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,5"
                    SizeChanged="Toolbar_SizeChanged">
                <DockPanel x:Name="ToolbarPanel" LastChildFill="False">
                    <!-- Quick connect: user@host[:port], or rdp://host -->
                    <Grid x:Name="QuickPanel" DockPanel.Dock="Right" Width="270" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="QuickBox" Padding="26,4,6,4" KeyDown="QuickBox_KeyDown" TextChanged="QuickBox_TextChanged"
                                 ToolTip="Quick connect: user@host or user@host:port for SSH, rdp://host for Remote Desktop, vnc://host for VNC, https://address for a web page. Press Enter." />
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE71B;" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="QuickHint" Text="Quick connect or search" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                   Margin="28,0,0,0" IsHitTestVisible="False" />
                        <!-- Recent sessions (empty box) or saved sessions matching what is typed -->
                        <Popup x:Name="QuickPopup" PlacementTarget="{Binding ElementName=QuickBox}" Placement="Bottom" StaysOpen="False"
                               AllowsTransparency="True" VerticalOffset="2" Focusable="False">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, ElementName=QuickBox}">
                                <StackPanel>
                                    <TextBlock x:Name="QuickListTitle" FontSize="11" Margin="8,4,8,4" Foreground="{DynamicResource SubTextBrush}" />
                                    <ListBox x:Name="QuickList" BorderThickness="0" Background="Transparent" Focusable="False" MaxHeight="320"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button x:Name="NewButton" Style="{StaticResource ToolButton}" Click="New_Click"
                            ToolTip="New SSH, Remote Desktop, VNC or web session, or a new folder (Ctrl+N: a session for the tab that is shown)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="{DynamicResource ToolIconMargin}" />
                            <TextBlock Text="New" Visibility="{DynamicResource ToolLabelVisibility}" />
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" Margin="4,1,0,0"
                                       Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="ImportExport_Click" ToolTip="Save or load your session list, or import single sessions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B5;" VerticalAlignment="Center" Margin="{DynamicResource ToolIconMargin}" />
                            <TextBlock Text="Import / Export" Visibility="{DynamicResource ToolLabelVisibility}" />
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="9" VerticalAlignment="Center" Margin="4,1,0,0"
                                       Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="Credentials_Click" ToolTip="Shared usernames and passwords used by several sessions">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8D7;" Foreground="{DynamicResource FolderBrush}" VerticalAlignment="Center" Margin="{DynamicResource ToolIconMargin}" />
                            <TextBlock Text="Credentials" Visibility="{DynamicResource ToolLabelVisibility}" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Margin="4,5,8,5" Background="{DynamicResource BorderBrush}" />

                    <ToggleButton x:Name="FilesToggle" Style="{StaticResource ToolToggle}" Click="FilesToggle_Click" IsEnabled="False"
                                  ToolTip="Show or hide the SFTP file browser for this SSH tab">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8B7;" Foreground="{DynamicResource FolderBrush}" VerticalAlignment="Center" Margin="{DynamicResource ToolIconMargin}" />
                            <TextBlock Text="Files" Visibility="{DynamicResource ToolLabelVisibility}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="FindButton" Style="{StaticResource ToolButton}" Click="Find_Click" IsEnabled="False"
                            ToolTip="Find text in the terminal (Ctrl+Shift+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE721;" VerticalAlignment="Center" Margin="{DynamicResource ToolIconMargin}" />
                            <TextBlock Text="Find" Visibility="{DynamicResource ToolLabelVisibility}" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="MultiExecToggle" Style="{StaticResource ToolToggle}" Checked="MultiExecToggle_Click" Unchecked="MultiExecToggle_Click"
                                  ToolTip="Multi-exec: what you type in one SSH tab is sent to all included SSH tabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE895;" Foreground="#E3A008" VerticalAlignment="Center" Margin="{DynamicResource ToolIconMargin}" />
                            <TextBlock Text="Multi-exec" Visibility="{DynamicResource ToolLabelVisibility}" />
                        </StackPanel>
                    </ToggleButton>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="160" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- Session list -->
                <DockPanel Background="{DynamicResource ShellPanelBrush}">
                    <Border DockPanel.Dock="Top" Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBox x:Name="FilterBox" Padding="24,4,30,4" TextChanged="FilterBox_TextChanged" />
                            <ToggleButton x:Name="FavoritesOnly" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="5,0" MinHeight="22" Click="FavoritesOnly_Click"
                                          Style="{StaticResource ToolToggle}" ToolTip="Show only favourites (right-click a session to make it one)">
                                <TextBlock x:Name="FavoritesOnlyStar" FontFamily="{StaticResource Icons}" Text="&#xE734;" FontSize="11"
                                           Foreground="{DynamicResource SubTextBrush}" />
                            </ToggleButton>
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE721;" Foreground="{DynamicResource SubTextBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="FilterHint" Text="Filter sessions  (Ctrl+F)" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center"
                                       Margin="27,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <!-- SSH / RDP / VNC tabs above the list; each can be hidden -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4,6,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="6,0" MinHeight="26" VerticalAlignment="Center" Margin="4,0,0,2" Click="TabsMenu_Click"
                                    ToolTip="List options: which tabs to show, online status, sorting">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE712;" FontSize="12" />
                            </Button>
                            <UniformGrid x:Name="ListTabs" Rows="1">
                            <RadioButton x:Name="SshTab" GroupName="ListTabs" Style="{StaticResource ListTab}" Tag="Ssh"
                                         Checked="ListTab_Checked" ContextMenuOpening="ListTab_ContextMenuOpening">
                                <RadioButton.ContextMenu><ContextMenu /></RadioButton.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE756;" FontSize="13" Foreground="{DynamicResource SshBrush}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="SshLabel" Text="SSH" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SshCount" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RdpTab" GroupName="ListTabs" Style="{StaticResource ListTab}" Tag="Rdp"
                                         Checked="ListTab_Checked" ContextMenuOpening="ListTab_ContextMenuOpening">
                                <RadioButton.ContextMenu><ContextMenu /></RadioButton.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F4;" FontSize="13" Foreground="{DynamicResource RdpBrush}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="RdpLabel" Text="RDP" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RdpCount" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="VncTab" GroupName="ListTabs" Style="{StaticResource ListTab}" Tag="Vnc"
                                         Checked="ListTab_Checked" ContextMenuOpening="ListTab_ContextMenuOpening">
                                <RadioButton.ContextMenu><ContextMenu /></RadioButton.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8AF;" FontSize="13" Foreground="{DynamicResource VncBrush}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="VncLabel" Text="VNC" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VncCount" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="WebTab" GroupName="ListTabs" Style="{StaticResource ListTab}" Tag="Web"
                                         Checked="ListTab_Checked" ContextMenuOpening="ListTab_ContextMenuOpening">
                                <RadioButton.ContextMenu><ContextMenu /></RadioButton.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE774;" FontSize="13" Foreground="{DynamicResource WebBrush}"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="WebLabel" Text="Web" VerticalAlignment="Center" />
                                    <TextBlock x:Name="WebCount" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </StackPanel>
                            </RadioButton>
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                    <Grid>
                    <TextBlock x:Name="EmptyTabHint" TextWrapping="Wrap" TextAlignment="Center" Margin="16,24" VerticalAlignment="Top"
                               Foreground="{DynamicResource SubTextBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                    <TreeView x:Name="Tree" BorderThickness="0" Padding="4,6" AllowDrop="True"
                              Background="Transparent" Foreground="{DynamicResource TextBrush}"
                              VirtualizingPanel.IsVirtualizing="False"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Tree_PreviewMouseMove"
                              DragOver="Tree_DragOver" Drop="Tree_Drop" DragLeave="Tree_DragLeave"
                              KeyDown="Tree_KeyDown"
                              ContextMenuOpening="Tree_ContextMenuOpening">
                        <TreeView.ContextMenu>
                            <ContextMenu />
                        </TreeView.ContextMenu>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Padding" Value="2,5,8,5" />
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="Bd" CornerRadius="6" Margin="4,1" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" Style="{StaticResource TreeExpander}" ClickMode="Press"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Margin="18,0,0,0" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsPicked}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type core:Node}" ItemsSource="{Binding Children}">
                                <StackPanel x:Name="RowPanel" Orientation="Horizontal" ToolTip="{Binding ReachText}" ToolTipService.InitialShowDelay="600">
                                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="Icon" FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" FontSize="14"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource FolderBrush}" />
                                        <!-- Online / offline: a small dot on the icon's corner -->
                                        <Ellipse x:Name="ReachDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,-2,-1" Visibility="Collapsed" Stroke="{DynamicResource ShellPanelBrush}" StrokeThickness="1" />
                                    </Grid>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="FavStar" FontFamily="{StaticResource Icons}" Text="&#xE735;" FontSize="10" Margin="6,1,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource FolderBrush}" Visibility="Collapsed" ToolTip="Favourite" />
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <Border x:Name="CountBadge" Background="{DynamicResource BadgeBrush}" CornerRadius="7" Padding="6,0" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Items in this folder">
                                        <TextBlock Text="{Binding Children.Count}" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                                    </Border>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSession}" Value="True" />
                                            <Condition Binding="{Binding Protocol}" Value="{x:Static core:Protocol.Ssh}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SshBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSession}" Value="True" />
                                            <Condition Binding="{Binding Protocol}" Value="{x:Static core:Protocol.Rdp}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource RdpBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSession}" Value="True" />
                                            <Condition Binding="{Binding Protocol}" Value="{x:Static core:Protocol.Vnc}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource VncBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSession}" Value="True" />
                                            <Condition Binding="{Binding Protocol}" Value="{x:Static core:Protocol.Web}" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource WebBrush}" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter TargetName="CountBadge" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="FavStar" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Reach}" Value="{x:Static core:Reachability.Unknown}">
                                        <Setter TargetName="RowPanel" Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Reach}" Value="{x:Static core:Reachability.Online}">
                                        <Setter TargetName="ReachDot" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="ReachDot" Property="Fill" Value="#2DB04B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Reach}" Value="{x:Static core:Reachability.Offline}">
                                        <Setter TargetName="ReachDot" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="ReachDot" Property="Fill" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                        <Setter TargetName="CountBadge" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <!-- Where a dragged item will land: a line between rows, or a frame around a folder -->
                    <Canvas x:Name="DropLayer" IsHitTestVisible="False">
                        <Border x:Name="DropLine" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        <Border x:Name="DropBox" BorderThickness="1.5" CornerRadius="6" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    </Canvas>
                    </Grid>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource Splitter}" />

                <!-- Tabs -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="TabStrip" Background="{DynamicResource ShellTabStripBrush}" BorderThickness="0" Padding="8,6,8,0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             SelectionChanged="TabStrip_SelectionChanged"
                             ContextMenuOpening="TabStrip_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,4,0" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="Bd" Background="{DynamicResource TabBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="12,7,8,7" Opacity="0.85">
                                                    <ContentPresenter />
                                                </Border>
                                                <!-- Accent line on the active tab -->
                                                <Border x:Name="Accent" Height="2" VerticalAlignment="Top" Margin="1,0" CornerRadius="2,2,0,0"
                                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                    <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}" />
                                                    <Setter TargetName="Bd" Property="Opacity" Value="1" />
                                                    <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="PreviewMouseDown" Handler="TabItem_PreviewMouseDown" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:OpenTab}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="{Binding Glyph}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE895;" Foreground="#E3A008" FontSize="11" VerticalAlignment="Center"
                                               Margin="0,0,8,0" ToolTip="Included in multi-exec"
                                               Visibility="{Binding IsBroadcasting, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource TabCloseButton}" Click="TabCloseButton_Click" ToolTip="Close (Ctrl+Shift+W)">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="9" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid x:Name="TabHost" Grid.Row="1" Background="{DynamicResource ShellPanelBrush}">
                        <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F4;" FontSize="48" Foreground="{DynamicResource BorderBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Double-click a session to connect" Foreground="{DynamicResource SubTextBrush}" FontSize="15" Margin="0,16,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="Right-click the list for more options" Foreground="{DynamicResource SubTextBrush}" Opacity="0.8" Margin="0,4,0,0" HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                                <Button Click="NewSsh_Click" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE756;" Foreground="{DynamicResource SshBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="New SSH session" />
                                    </StackPanel>
                                </Button>
                                <Button Click="NewRdp_Click" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7F4;" Foreground="{DynamicResource RdpBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="New RDP session" />
                                    </StackPanel>
                                </Button>
                                <Button Click="NewVnc_Click" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8AF;" Foreground="{DynamicResource VncBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="New VNC session" />
                                    </StackPanel>
                                </Button>
                                <Button Click="NewWeb_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE774;" Foreground="{DynamicResource WebBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="New web session" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
