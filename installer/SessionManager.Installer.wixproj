<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Builds SessionManager-<version>.msi from the published app. Run build.ps1 rather than building this directly. -->
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- One MSI per language: English (the default) and Lithuanian. -->
    <Cultures>en-US;lt-LT</Cultures>
    <Platform>x64</Platform>
    <OutputName>SessionManager-$(ProductVersion)</OutputName>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\</PublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);PublishDir=$(PublishDir);IconPath=$(MSBuildThisFileDirectory)..\src\SessionManager\Assets\app.ico</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\artifacts\installer\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</IntermediateOutputPath>
  </PropertyGroup>
</Project>
